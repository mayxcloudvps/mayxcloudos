#!/bin/sh
set -e

# FAST=1: nén squashfs bằng zstd (build nhanh hơn, ISO to hơn ~15-20%)
if [ "${FAST:-0}" = "1" ]; then
	set -- --chroot-squashfs-compression-type zstd --chroot-squashfs-compression-level 3 "$@"
fi

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--bootloaders "grub-efi,syslinux" \
	--debian-installer none \
	--linux-flavours amd64 \
	--security true \
	--updates true \
	--memtest none \
	--checksums sha256 \
	--iso-application "mayxcloudos" \
	--iso-publisher "MayXCloud" \
	--iso-volume "MAYXCLOUDOS" \
	--image-name "mayxcloudos" \
	--bootappend-live "boot=live components quiet splash username=may hostname=mayxcloudos locales=vi_VN.UTF-8 timezone=Asia/Ho_Chi_Minh keyboard-layouts=us" \
	"${@}"
